{
  "$schema": "https://opencode.ai/config.json",
  // Sur `deny`, le sous-agent est retiré de la description de l'outil Task :
  // il ne coûte plus rien en contexte. OpenCode est le seul runtime du parc
  // à offrir ce levier. Les 3 workers spécialisés couvrent le besoin réel ;
  // `general` et `explore` font doublon avec eux et avec l'orchestrateur.
  "permission": {
    "task": {
      "general": "deny",
      "explore": "deny"
    }
  },
  // La clé d'un modèle est l'id envoyé à l'API. La gateway :4002 expose
  // `qwen-3.6-35b-moe` ; `Qwen 3.6 35b MoE` n'existe que sur :8000 (llama.cpp
  // direct). L'ancien id ne correspondait à rien sur :4002 : le modèle
  // répondait vide. Vérifié via GET :4002/v1/models.
  "model": "vps-ia/qwen-3.6-35b-moe",
  "provider": {
    "vps-ia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VPS IA (Qwen 35B Sanitized)",
      "options": {
        "baseURL": "http://100.99.75.104:4002/v1"
      },
      "models": {
        "qwen-3.6-35b-moe": {
          "name": "Qwen 3.6 35B MoE (96k Ctx)",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        }
      }
    }
  }
}
