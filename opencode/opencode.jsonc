{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "task": {
      "general": "deny",
      "explore": "deny"
    }
  },
  "model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "vps-ia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VPS IA (Qwen 35B Sanitized)",
      "options": {
        "baseURL": "http://100.99.75.104:4002/v1"
      },
      "models": {
        "qwen-3.6-35b-moe": {
          "name": "Qwen 3.6 35B MoE (96k Ctx)",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        }
      }
    },
    "apinex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "APInex",
      "options": {
        "baseURL": "https://api.apinex.bond/v1",
        "apiKey": "{env:APINEX_API_KEY}"
      },
      "models": {
        "claude/opus-5": {
          "name": "Claude Opus 5"
        },
        "claude/sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "free/deepseek-v4-flash-0731": {
          "name": "Deepseek V4 Flash"
        },
        "deepseek/v4-flash": {
          "name": "Deepseek V4 Flash"
        },
        "free/deepseek-v4-pro-0813": {
          "name": "Deepseek V4 Pro"
        },
        "deepseek/v4-pro": {
          "name": "Deepseek V4 Pro"
        },
        "glm/5.3": {
          "name": "GLM 5.3"
        },
        "free/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Free)"
        },
        "glm/5.3-flash": {
          "name": "GLM-5.3 Flash"
        },
        "gemini/3.1-pro": {
          "name": "Gemini 3.1 Pro"
        },
        "free/gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Free)"
        },
        "gemini/3.8-flash": {
          "name": "Gemini 3.8 Flash"
        },
        "free/muse-spark-1.3": {
          "name": "Muse Spark 1.3 (Free)"
        }
      }
    },
    "experiential": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  },
  "mcp": {
    "vault": {
      "type": "remote",
      "url": "https://mymcps.duckdns.org/vault/mcp",
      "headers": {
        "Authorization": "Bearer {env:VAULT_MCP_TOKEN}"
      },
      "timeout": 60000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "node",
        "C:\\Tools\\chrome-devtools-wrapper.mjs",
        "--no-launch"
      ],
      "timeout": 60000
    }
  }
}
