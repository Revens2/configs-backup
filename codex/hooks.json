{
  "description": "Codex lifecycle hooks — notif uniquement fin de tache principale (pas de sous-agents).",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/save-state.mjs",
            "timeout": 10,
            "statusMessage": "Saving session state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/save-state.mjs",
            "timeout": 10,
            "statusMessage": "Refreshing session state"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/restore-state.mjs",
            "timeout": 10,
            "additionalContextLimit": 2500,
            "statusMessage": "Restoring session state"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/save-state.mjs",
            "timeout": 3,
            "statusMessage": "Saving final session state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/codegraph-post-edit.mjs",
            "async": true,
            "timeout": 30,
            "statusMessage": "Updating code graph"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ~/.claude/hooks/agent-notify.ps1 -Event completed -Harness codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
